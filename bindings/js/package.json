{
  "name": "ccharts",
  "version": "0.2.0",
  "description": "Terminal charts for financial OHLC data (line and candlestick), as ANSI-colored Unicode block characters",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "vendor",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "test": "node --test"
  },
  "keywords": [
    "chart",
    "candlestick",
    "ohlc",
    "terminal",
    "cli",
    "financial",
    "ascii",
    "trading",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dethrandir/ccharts.git",
    "directory": "bindings/js"
  },
  "homepage": "https://github.com/dethrandir/ccharts",
  "bugs": {
    "url": "https://github.com/dethrandir/ccharts/issues"
  }
}
