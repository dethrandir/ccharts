# frozen_string_literal: true

# Build + test tasks for the Ruby binding. `rake compile` compiles the vendored
# C ABI into lib/ccharts_ext.so (Fiddle dlopens it from lib/); the same steps
# run when RubyGems installs the gem from source (spec.extensions).

EXT_DIR  = File.expand_path("ext/ccharts", __dir__)
LIB_SO   = File.expand_path("lib/ccharts_ext.#{RbConfig::CONFIG["DLEXT"]}", __dir__)

desc "Compile the vendored C ABI into lib/ccharts_ext.so"
task :compile do
  sh "ruby extconf.rb", chdir: EXT_DIR
  sh "make", chdir: EXT_DIR
  sh "cp #{File.join(EXT_DIR, "ccharts_ext.#{RbConfig::CONFIG["DLEXT"]}")} #{LIB_SO}"
end

desc "Remove build artifacts"
task :clean do
  FileUtils.rm_f([LIB_SO, *Dir.glob(File.join(EXT_DIR, "*.{o,so,log}")),
                  File.join(EXT_DIR, "Makefile")])
  FileUtils.rm_rf(File.join(EXT_DIR, "mkmf.log"))
end

desc "Run the API tests"
task :test_api do
  sh "ruby -Ilib test/test_ccharts_api.rb"
end

desc "Run the 70-case conformance suite"
task :test_conformance do
  sh "ruby -Ilib test/test_conformance.rb"
end

desc "Run every test"
task test: [:compile, :test_api, :test_conformance]

task default: :test
